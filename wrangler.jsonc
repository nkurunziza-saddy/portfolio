{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The prerendered site, served as static files: no Worker code runs for a page.
  "name": "portfolio",
  "account_id": "956e9453e0dd20d0e539d0650bc53b05",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "saddy.me", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
